<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:MarkMello.Presentation.Views">

  <!--
    Полоса прокрутки MarkMello — одна на все платформы, вместо полосы WinUI из
    Fluent: без кнопок-стрелок и без дорожки, только скруглённый ползунок цвета
    текста. В покое его не видно: он появляется на время прокрутки
    (views:ScrollBarReveal, класс mm-scrolling) и при наведении на край
    (IsExpanded), тогда же расширяется с 7 до 11 px. Толщина самой полосы — 12 px:
    ползунок прижат к внешнему краю, и на неё рассчитаны места под полосу у таблиц,
    блоков кода и диаграмм. Горизонтальная полоса блока, который шире колонки,
    видна и в покое — класс mm-scrollbar-persistent на ScrollViewer, Controls.axaml.
  -->

  <ControlTheme x:Key="MmScrollBarPageButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="MmScrollBarThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource MmScrollThumbBrush}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        <DoubleTransition Property="Width" Duration="0:0:0.1" />
        <DoubleTransition Property="Height" Duration="0:0:0.1" />
        <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="MinHeight" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="views:ScrollBarReveal.IsEnabled" Value="True" />

    <Style Selector="^:vertical">
      <Setter Property="Width" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Margin="0,2"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton"
                              Classes="largeIncrease"
                              Theme="{StaticResource MmScrollBarPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton"
                              Classes="largeIncrease"
                              Theme="{StaticResource MmScrollBarPageButton}" />
              </Track.IncreaseButton>
              <Thumb Theme="{StaticResource MmScrollBarThumb}" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Margin="2,0"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton"
                              Classes="largeIncrease"
                              Theme="{StaticResource MmScrollBarPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton"
                              Classes="largeIncrease"
                              Theme="{StaticResource MmScrollBarPageButton}" />
              </Track.IncreaseButton>
              <Thumb Theme="{StaticResource MmScrollBarThumb}" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Размеры ползунка — стилями, а не в шаблоне: иначе развёрнутое состояние
         их не перекроет. -->
    <Style Selector="^:vertical /template/ Thumb">
      <Setter Property="Width" Value="7" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="CornerRadius" Value="3.5" />
      <Setter Property="Margin" Value="0,0,1,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="^:horizontal /template/ Thumb">
      <Setter Property="Height" Value="7" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="CornerRadius" Value="3.5" />
      <Setter Property="Margin" Value="0,0,0,1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style Selector="^.mm-scrolling /template/ Thumb">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="^[IsExpanded=True] /template/ Thumb">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource MmScrollThumbHoverBrush}" />
      <Setter Property="CornerRadius" Value="5.5" />
    </Style>
    <Style Selector="^[IsExpanded=True]:vertical /template/ Thumb">
      <Setter Property="Width" Value="11" />
    </Style>
    <Style Selector="^[IsExpanded=True]:horizontal /template/ Thumb">
      <Setter Property="Height" Value="11" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
