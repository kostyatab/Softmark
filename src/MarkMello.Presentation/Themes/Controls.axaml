<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:views="using:MarkMello.Presentation.Views">

  <!--
    Всплывающие подсказки. У Fluent отступы несимметричные (5 сверху, 7 снизу —
    под метрики Segoe UI) и поднимали текст над центром. Inter из сборки
    (ContentControlThemeFontFamily в Typography.axaml) центрируется в строке
    сам, поэтому отступы ровные. Шрифт задан явно: иначе подсказка наследует
    его от владельца и у кнопки в моноширинном блоке набралась бы моно.
  -->
  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <!--
    ============================== Кнопки ==============================

    У кнопки пять ролей, и каждая описана здесь один раз:

      mm-action-primary / -secondary / -destructive — текстовое действие;
      mm-icon-button — иконка-кнопка (в том числе кнопки строки окна);
      mm-row-primary, titlebar, mm-tab-overflow — кнопки строки окна и вкладок;
      mm-list-item — пункт списка или меню;
      mm-link — ссылка.

    Роль ставится классом в разметке, класс места идёт рядом с ней
    («mm-icon-button mm-find-button») и меняет только размеры и отступы. Свои
    цвета по месту не заводим: из-за этого состояния и расходились (MM-42).

    Цвет состояния задан у ContentPresenter: Fluent красит кнопку своими кистями
    в :pointerover, :pressed, :disabled и :checked, и без явного правила зажатая
    кнопка, с которой увели курсор, сереет. Иконки (Views/LucideIcon) берут цвет
    из Foreground, как текст, поэтому каждое состояние называет и его. Порядок
    правил важен — при нескольких состояниях сразу побеждает правило ниже, а
    класс места стоит после роли.
  -->

  <!--
    Текстовое действие (A-Dialog, A-Welcome, A-LoadError, A-AppSettings): 32 px,
    радиус 8. Вторичная — заливка вкладки, основная — цветом текста, опасная —
    акцентом. Выключенная держит цвета роли и гаснет до 0.6: серый Fluent
    выбивался из палитры. Фокус с клавиатуры — кольцо акцентом через 2 px, как
    у вкладок.
  -->
  <Style Selector="Button.mm-action-primary, Button.mm-action-secondary, Button.mm-action-destructive">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-4"
                BorderThickness="2"
                CornerRadius="12"
                BorderBrush="{DynamicResource MmAccentBrush}"
                AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.mm-action-secondary">
    <Setter Property="Background" Value="{DynamicResource MmTabBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="Button.mm-action-secondary:pointerover /template/ ContentPresenter, Button.mm-action-secondary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="Button.mm-action-secondary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Button.mm-action-primary">
    <Setter Property="Background" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmBackgroundBrush}" />
  </Style>
  <Style Selector="Button.mm-action-primary:pointerover /template/ ContentPresenter, Button.mm-action-primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmBackgroundBrush}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.mm-action-primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmBackgroundBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Button.mm-action-destructive">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmElevatedBackgroundBrush}" />
  </Style>
  <Style Selector="Button.mm-action-destructive:pointerover /template/ ContentPresenter, Button.mm-action-destructive:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.mm-action-destructive:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!--
    Тон «на заливке»: кнопка стоит на залитой поверхности (полоса «изменён на
    диске», блок обновлений в «Настройках»), где заливка вкладки не читается, —
    поверхность карточки с рамкой, под курсором заливка наведения.
  -->
  <Style Selector="Button.mm-action-raised">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.mm-action-raised:pointerover /template/ ContentPresenter, Button.mm-action-raised:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
  </Style>
  <Style Selector="Button.mm-action-raised:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- Размеры по месту: стартовый экран и экран ошибки — на 2 px выше (раньше
       welcome-action и mm-error-action), блок обновлений — на 2 px ниже.
       У кнопки с иконкой слева отступ меньше, как в макете. -->
  <Style Selector="Button.mm-action-large">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="15,0" />
  </Style>
  <Style Selector="Button.mm-action-small">
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.mm-action-with-icon">
    <Setter Property="Padding" Value="12,0,14,0" />
  </Style>

  <!--
    Иконка-кнопка: прозрачная, под курсором — заливка наведения вкладки, нажатая —
    заливка активной, выключенная гаснет иконкой. Размер и радиус — от класса места.
  -->
  <Style Selector="Button.mm-icon-button, ToggleButton.mm-icon-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3"
                BorderThickness="2"
                CornerRadius="11"
                BorderBrush="{DynamicResource MmAccentBrush}"
                AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.mm-icon-button:pointerover /template/ ContentPresenter, ToggleButton.mm-icon-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="Button.mm-icon-button:pressed /template/ ContentPresenter, ToggleButton.mm-icon-button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <!-- Карточка открыта (:checked, а у кнопки меню-карточки — класс open) — заливка
       держится и под курсором, поэтому ниже -->
  <Style Selector="ToggleButton.mm-icon-button:checked /template/ ContentPresenter, Button.mm-icon-button.open /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <!-- Тон «голая»: крестик внутри вкладки и в списке «ещё N» — своей подложки нет,
       на курсор отвечает только иконка. -->
  <Style Selector="Button.mm-icon-button.mm-icon-button-bare:pointerover /template/ ContentPresenter, Button.mm-icon-button.mm-icon-button-bare:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <!-- Тон «на заливке»: кнопка стоит на залитой дорожке или на блоке кода, где
       заливка вкладки не читается, — под курсором светлеет до поверхности карточки. -->
  <Style Selector="Button.mm-icon-button.mm-icon-button-raised:pointerover /template/ ContentPresenter, Button.mm-icon-button.mm-icon-button-raised:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <!-- Кнопки строки окна и шапки сайдбара (ADR-0009 Rule 2): 30×30, радиус 8 -->
  <Style Selector="Button.mm-icon-button.mm-row-button, ToggleButton.mm-icon-button.mm-row-button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ✕ в шапке окна «Настройки»: 28×28, радиус 8 -->
  <Style Selector="Button.mm-icon-button.mm-settings-close">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <!-- Кнопки карточки поиска (A-CollapsedFind): 28×28, радиус 7 -->
  <Style Selector="Button.mm-icon-button.mm-find-button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Крестик вкладки: 18×18, радиус 5. В обход по Tab не встаёт — вкладку с
       клавиатуры закрывает ⌘W; показывает его вкладка под курсором. -->
  <Style Selector="Button.mm-icon-button.mm-tab-close">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Крестик в списке «ещё N»: 14×14, проявляется под курсором строки. Фокус не
       берёт, как крестик вкладки: невидимым он встал бы в обход по Tab, а нажатый —
       унёс бы фокус из меню вместе с удалённой строкой. -->
  <Style Selector="Button.mm-icon-button.mm-tab-overflow-close">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- «− N px +» (A-SetAa): 28×26, радиус 6. На границе диапазона кнопка гаснет,
       а не исчезает: подпись не прыгает. -->
  <Style Selector="Button.mm-icon-button.mm-card-step">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.mm-icon-button.mm-card-step:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Панель редактора: 28×24, радиус 4 -->
  <Style Selector="Button.mm-icon-button.mm-editor-toolbar-button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- Выключенная — в самом низу роли: выключенная кнопка продолжает получать
       :pointerover (Avalonia смотрит на IsHitTestVisible, а не на IsEnabled), и
       из равных побеждает правило ниже. Класс места, которому нужен свой фон
       выключенной (mm-code-copy-button), стоит после этого правила. -->
  <Style Selector="Button.mm-icon-button:disabled /template/ ContentPresenter, ToggleButton.mm-icon-button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>

  <!--
    «Копировать» у блока кода: размеры, скругление и положение задаёт MarkdownDocumentView
    (кнопка стоит в верхнем поле листа). В покое иконка того же тона, что и
    подпись, — они читаются как пара; фон и рамка в покое — цвета блока кода, а не
    Transparent, иначе кнопка проступала бы на полосе прокрутки кода.
  -->
  <Style Selector="Button.mm-icon-button.mm-code-copy-button">
    <Setter Property="Background" Value="{DynamicResource MmCodeBlockBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmCodeBlockBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.mm-icon-button.mm-code-copy-button:pointerover /template/ ContentPresenter, Button.mm-icon-button.mm-code-copy-button:pressed /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
  </Style>
  <Style Selector="Button.mm-icon-button.mm-code-copy-button:focus-visible /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="Button.mm-icon-button.mm-code-copy-button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmCodeBlockBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmCodeBlockBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>

  <!--
    «Готово» в правке — единственная залитая кнопка строки (ADR-0009 Rule 2): фон цвета
    текста, текст цвета фона, радиус и высота как у кнопок-иконок. Отступ 2 по бокам —
    с холста: залитой кнопке нужно чуть больше воздуха, чем прозрачным. Заливка держится во
    всех состояниях, иначе Fluent перекрашивает её под курсором (и на миг, пока команда
    выполняется, — как недоступную); наведение и нажатие чуть приглушают кнопку целиком.
  -->
  <Style Selector="Button.mm-row-primary">
    <Setter Property="Background" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="11,0,13,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-4"
                BorderThickness="2"
                CornerRadius="12"
                BorderBrush="{DynamicResource MmAccentBrush}"
                AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.mm-row-primary:pointerover /template/ ContentPresenter, Button.mm-row-primary:pressed /template/ ContentPresenter, Button.mm-row-primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmBackgroundBrush}" />
  </Style>
  <Style Selector="Button.mm-row-primary:pointerover">
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.mm-row-primary:pressed">
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!--
    «ещё N» (A-Tabs): плашка той же высоты и заливки, что вкладка; пока меню открыто
    или кнопку держат — заливка активной вкладки.
  -->
  <Style Selector="Button.mm-tab-overflow">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0,8,0" />
    <Setter Property="Background" Value="{DynamicResource MmTabBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3"
                BorderThickness="2"
                CornerRadius="11"
                BorderBrush="{DynamicResource MmAccentBrush}"
                AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.mm-tab-overflow:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="Button.mm-tab-overflow:pressed /template/ ContentPresenter, Button.mm-tab-overflow.open /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>

  <Style Selector="Button.mm-tab-overflow:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>

  <!--
    Кнопки окна Windows (свернуть / развернуть / закрыть) — системные глифы на всю
    высоту строки окна. Цвет глифа задан здесь, а не на самом Path: у крестика
    под курсором он белый на красном, как у системных кнопок. В обход по Tab
    кнопки не встают, поэтому кольца фокуса у них нет.
  -->
  <Style Selector="Button.titlebar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.titlebar Path">
    <Setter Property="Stroke" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Button.titlebar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
  </Style>
  <Style Selector="Button.titlebar:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabActiveBrush}" />
  </Style>
  <Style Selector="Button.titlebar:pointerover Path, Button.titlebar:pressed Path">
    <Setter Property="Stroke" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="Button.titlebar.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E81123" />
  </Style>
  <!-- Нажатый крестик — тот же красный, притушенный: второго красного в палитре нет -->
  <Style Selector="Button.titlebar.close:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#E81123" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Button.titlebar.close:pointerover Path, Button.titlebar.close:pressed Path">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <Style Selector="Button.titlebar:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.titlebar:disabled Path">
    <Setter Property="Stroke" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>

  <!--
    Пункт списка или меню: строка во всю ширину, прозрачная в покое; под курсором и
    при фокусе с клавиатуры — заливка наведения вкладки, нажатая — заливка активной,
    неприменимая гаснет подписью. Высота и отступы — от класса места: пункт меню ⋯,
    строка «Недавних», находка поиска, пункт списка «ещё N», «имя папки ▾» и
    строка-подвал карточки.
  -->
  <Style Selector="Button.mm-list-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.mm-list-item /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="Button.mm-list-item:pointerover /template/ ContentPresenter, Button.mm-list-item:focus-visible /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="Button.mm-list-item:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <!-- Тон «деструктивный»: удаление в меню строки дерева — акцентом во всех
       состояниях, кроме выключенного (оно ниже по роли и гасит подпись). -->
  <Style Selector="Button.mm-list-item.mm-menu-destructive /template/ ContentPresenter, Button.mm-list-item.mm-menu-destructive:pointerover /template/ ContentPresenter, Button.mm-list-item.mm-menu-destructive:pressed /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
  </Style>

  <!-- Строка «Недавних» (A-Welcome): 46 px -->
  <Style Selector="Button.mm-list-item.recent-row">
    <Setter Property="Height" Value="46" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <!-- Находка поиска по сайдбару: две строки, поэтому высота по содержимому -->
  <Style Selector="Button.mm-list-item.mm-search-hit">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <!-- «имя папки ▾»: кнопка с меню действий над папкой (ADR-0009 Rule 4) -->
  <Style Selector="Button.mm-list-item.mm-sidebar-folder">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- «Язык, обновления, версия · Настройки… [⌘] [,]» — строка во всю ширину карточки -->
  <Style Selector="Button.mm-list-item.mm-card-footer">
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="-8,0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="0,0,6,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <!-- Линия над подвалом видна во всех состояниях, подпись не темнеет под курсором -->
  <Style Selector="Button.mm-list-item.mm-card-footer /template/ ContentPresenter, Button.mm-list-item.mm-card-footer:pointerover /template/ ContentPresenter, Button.mm-list-item.mm-card-footer:pressed /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>

  <!-- Выключенная — в самом низу роли: под курсором выключенная кнопка тоже
       получает :pointerover, а из равных побеждает правило ниже. -->
  <Style Selector="Button.mm-list-item:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>

  <!--
    Ссылка: текст без фона и рамки, подчёркивание — по наведению. Акцентный тон —
    ссылки «Настроек» и окна «О программе»; приглушённый (mm-link-quiet) —
    «Очистить» в «Недавних»: мягкий текст темнеет, но не подчёркивается.
  -->
  <Style Selector="Button.mm-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3"
                BorderThickness="2"
                CornerRadius="6"
                BorderBrush="{DynamicResource MmAccentBrush}"
                AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.mm-link /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
  </Style>
  <Style Selector="Button.mm-link:pointerover /template/ ContentPresenter, Button.mm-link:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
  </Style>
  <Style Selector="Button.mm-link:not(.mm-link-quiet):pointerover /template/ ContentPresenter, Button.mm-link:not(.mm-link-quiet):pressed /template/ ContentPresenter">
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.mm-link.mm-link-quiet">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="Button.mm-link.mm-link-quiet /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="Button.mm-link.mm-link-quiet:pointerover /template/ ContentPresenter, Button.mm-link.mm-link-quiet:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <!-- Выключенная — ниже обоих тонов: иначе безусловный цвет тона её перекроет -->
  <Style Selector="Button.mm-link:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>

  <!-- «Не сохранено» рядом с «Готово»: короткая подпись и плашки [⌘] [S] -->
  <Style Selector="TextBlock.mm-row-status">
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Пропавшая с диска запись приглушена; клик по ней спрашивает, убрать ли её -->
  <Style Selector="Button.recent-row.missing Grid.recent-row-content">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!--
    Сочетание клавиш — ряд плашек, по клавише на плашку, как в Raycast: «⌘» «O» на
    macOS, «Ctrl» «O» на Windows и Linux. Клавиши — из ShortcutLabel.Keys; один ряд
    на все места: меню, строку окна, карточку Aa, стартовый экран и экран ошибки.
  -->
  <Style Selector="ItemsControl.mm-shortcut-keys">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="sys:String">
        <Border Classes="kbd">
          <TextBlock Text="{Binding}" />
        </Border>
      </DataTemplate>
    </Setter>
  </Style>

  <!--
    Плашка клавиши: ровная рамка, квадрат 20×20 под однознаковую клавишу — на macOS
    все модификаторы однознаковые (⌘ ⇧ ⌥), и плашки ряда выходят одной ширины. Поле 3,
    а не 4: ⌘ и ⇧ в Inter 11 шириной 12 px и при поле 4 квадрат не держат.
    Слова (Ctrl, Shift) плашку растягивают в прямоугольник. Шрифт интерфейсный, а не
    моноширинный: ⌘ ⌥ ⇧ ⌫ ⎋ в моно-начертании уходят в фолбэк и скачут по базовой линии.
  -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource MmKeyboardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmKeyboardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.kbd TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!--
    Поверхность карточек под строкой окна (ADR-0009 Rule 2) — поиска, Aa, меню ⋯
    и настроек: одна на всех, чтобы карточки не расходились при правке палитры.
  -->
  <Style Selector="Border.mm-settings-panel, Border.mm-find-card, Border.mm-outline-card">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{DynamicResource MmCardShadow}" />
  </Style>

  <!-- Карточка оглавления у правого края документа: ложится на рельс по наведению.
       Пункты — строки меню на 28 px, текущий раздел — акцентом во всех состояниях. -->
  <Style Selector="Border.mm-outline-card">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.mm-list-item.mm-outline-item">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.mm-list-item.mm-outline-item.mm-current /template/ ContentPresenter, Button.mm-list-item.mm-outline-item.mm-current:pointerover /template/ ContentPresenter, Button.mm-list-item.mm-outline-item.mm-current:pressed /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
  </Style>

  <!-- Карточка поиска по A-CollapsedFind: одна строка под кнопкой поиска -->
  <Style Selector="Border.mm-find-card">
    <Setter Property="Padding" Value="12,0,6,0" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- ClipToBounds карточке не ставим: он режет и её собственную тень -->
  <Style Selector="Border.mm-settings-panel">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="RenderTransformOrigin" Value="100%,0%" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="translate(0px,-6px) scale(0.96)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.mm-settings-panel.mm-popover-right">
    <Setter Property="RenderTransformOrigin" Value="100%,0%" />
  </Style>
  <!-- Карточки сайдбара раскрываются от левого края кнопки, а не от правого -->
  <Style Selector="Border.mm-settings-panel.mm-popover-left">
    <Setter Property="RenderTransformOrigin" Value="0%,0%" />
  </Style>
  <Style Selector="Window.mm-reading-settings-open Border.mm-settings-panel.mm-reading-panel">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)" />
  </Style>
  <Style Selector="Window.mm-app-menu-open Border.mm-settings-panel.mm-app-menu-panel">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)" />
  </Style>
  <!-- Меню сайдбара: один класс на все три карточки — открыта всегда только одна -->
  <Style Selector="Window.mm-sidebar-menu-open Border.mm-settings-panel.mm-sidebar-menu-panel">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)" />
  </Style>

  <Style Selector="Line.mm-setting-divider">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Stretch" Value="Fill" />
    <Setter Property="Stroke" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="2,2" />
  </Style>

  <!--
    Меню приложения — ⋯ (A-Menu), меню сайдбара и контекстное меню строки дерева —
    одна карточка: отступ 6, радиус 12, пункты 26 px — чуть свободнее системных 24,
    с плашками сочетания справа, группы через линии. Все меню внутри окна
    (ADR-0009 Rule 4), поэтому вид у них один и стили общие.
  -->
  <Style Selector="Border.mm-app-menu-panel, Border.mm-sidebar-menu-panel">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- Пункт меню — класс места у роли mm-list-item: только высота и отступы -->
  <Style Selector="Button.mm-list-item.mm-menu-command">
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Неприменимый пункт гасит плашки вместе с подписью: крышка сливается с карточкой,
       рамка и буква бледнеют -->
  <Style Selector="Button.mm-menu-command:disabled Border.kbd">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
  </Style>
  <Style Selector="Button.mm-menu-command:disabled Border.kbd TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>

  <Style Selector="Border.mm-menu-separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="10,5" />
    <Setter Property="Background" Value="{DynamicResource MmBorderSoftBrush}" />
  </Style>

  <!-- Меню сайдбара шире 200 не по содержимому, а по ширине системного меню -->
  <Style Selector="Border.mm-sidebar-menu-panel">
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="MaxWidth" Value="320" />
  </Style>

  <Style Selector="Border.mm-app-menu-panel">
    <Setter Property="Width" Value="288" />
  </Style>

  <Style Selector="Button.mm-menu-command TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    Контекстное меню документа (копировать, выделить всё) — единственное меню,
    оставшееся попапом ОС: оно принадлежит поверхности документа, а её MM-50 не трогала.
    Вид тот же, что у карточек, но цвета Fluent ставит у частей шаблона, и шаблон
    пункта меню другой — поэтому раскраска повторена здесь теми же кистями.
    Тени у попапа нет: он — отдельное окно ровно по размеру карточки, и BoxShadow
    обрезается его краем (ADR-0009 Rule 4).
  -->
  <Style Selector="ContextMenu">
    <!-- Отступ карточки и поле списка Fluent ставит в шаблоне из ресурсов —
         стиль их не перебивает, поэтому переопределены сами ресурсы -->
    <Style.Resources>
      <Thickness x:Key="FlyoutBorderThemePadding">6</Thickness>
      <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
    </Style.Resources>
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <!-- При открытии Fluent выделяет первый пункт сам — подсветка только под мышью
       и при навигации с клавиатуры, как у карточек -->
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:focus-visible /template/ Border#PART_LayoutRoot, MenuItem:open /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText, MenuItem:selected /template/ TextBlock#PART_InputGestureText, MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover TextBlock#PART_InputGestureText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>

  <!--
    Карточка Aa (A-SetAa): подпись над контролом, сегменты на всю ширину,
    размер текста — «− N px +», внизу строка к настройкам приложения.
  -->
  <Style Selector="Border.mm-view-card">
    <Setter Property="Padding" Value="16,14,16,12" />
  </Style>

  <Style Selector="TextBlock.mm-card-label">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.mm-card-value">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.mm-card-segments">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <Style Selector="ToggleButton.mm-card-segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- Иконка темы идёт за подписью: цвет задан у ContentPresenter во всех состояниях Fluent. -->
  <Style Selector="ToggleButton.mm-card-segment /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="ToggleButton.mm-card-segment:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.mm-card-segment:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.mm-card-segment:checked">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="ToggleButton.mm-card-segment:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #0F000000" />
  </Style>

  <Style Selector="Border.mm-card-stepper">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.mm-card-step-value">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.mm-card-footer-link">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    Селект языка (A-AppSettings): 30 px, от 160 px, радиус 8, заливка наведения вкладки,
    без рамки. Fluent красит подложку шаблона по состояниям своими кистями, поэтому
    состояния заданы у Border#Background явно.
  -->
  <Style Selector="ComboBox.mm-language-select">
    <Setter Property="Width" Value="160" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3"
                BorderThickness="2"
                CornerRadius="11"
                BorderBrush="{DynamicResource MmAccentBrush}"
                AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="ComboBox.mm-language-select /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBox.mm-language-select:pointerover /template/ Border#Background, ComboBox.mm-language-select:pressed /template/ Border#Background, ComboBox.mm-language-select:dropdownopen /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource MmTabActiveBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBox.mm-language-select TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!--
    Список языков — карточка, как меню ⋯: поверхность и рамка палитры, радиус 10,
    отступ 4, пункты 30 px с радиусом 7. Выбранный пункт — заливка активной вкладки,
    а не системная синяя Fluent.
  -->
  <Style Selector="ComboBox.mm-language-select /template/ Border#PopupBorder">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
  </Style>
  <Style Selector="ComboBox.mm-language-select /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- Шеврон Fluent — залитый PathIcon. Шаблонная часть та же (12×12, цвет по
       состояниям Fluent), а рисует её LucideIcon: цвет он наследует от PathIcon. -->
  <Style Selector="ComboBox.mm-language-select /template/ PathIcon#DropDownGlyph">
    <Setter Property="Template">
      <ControlTemplate>
        <views:LucideIcon Data="{DynamicResource LucideChevronDownGeometry}"
                          Width="12"
                          Height="12" />
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Между пунктами 2 px: выбранный и наведённый не сливаются в одну плашку -->
  <Style Selector="ComboBoxItem">
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="Slider.mm-settings-slider">
    <Setter Property="Width" Value="130" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Height="{TemplateBinding Height}"
              MinHeight="{TemplateBinding MinHeight}"
              ClipToBounds="False">
          <Border Height="2"
                  Background="{TemplateBinding Background}"
                  CornerRadius="1"
                  VerticalAlignment="Center" />
          <Track Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}"
                 Orientation="{TemplateBinding Orientation}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton"
                            Classes="mm-settings-slider-hitarea" />
            </Track.DecreaseButton>
            <Track.Thumb>
              <Thumb Classes="mm-settings-slider-thumb" />
            </Track.Thumb>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton"
                            Classes="mm-settings-slider-hitarea" />
            </Track.IncreaseButton>
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RepeatButton.mm-settings-slider-hitarea">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Thumb.mm-settings-slider-thumb">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="MinWidth" Value="14" />
    <Setter Property="MinHeight" Value="14" />
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="7" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Thumb.mm-settings-slider-thumb:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.15)" />
  </Style>

  <Style Selector="TextBlock.mm-slider-value">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentMonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!-- Ползунок карточки Aa — во всю ширину; правило ниже базового, чтобы перебить его Width -->
  <Style Selector="Slider.mm-settings-slider.mm-card-slider">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.mm-editor-pane">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="MinWidth" Value="280" />
  </Style>

  <Style Selector="Border.mm-editor-toolbar">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.mm-editor-toolbar-separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Background" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Полоса над предпросмотром — та же панель, но на фоне документа -->
  <Style Selector="Border.mm-editor-toolbar.mm-editor-preview-toolbar">
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource MmBackgroundBrush}" />
  </Style>

  <!-- Подпись панели правки — «Markdown» и «Предпросмотр» (A-EditDark) -->
  <Style Selector="TextBlock.mm-editor-toolbar-label">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <Style Selector="Border.mm-editor-preview-toolbar TextBlock.mm-editor-toolbar-label">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Border.mm-editor-status-shell">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="{DynamicResource MmBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="TextBlock.mm-editor-status-text">
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBox.mm-editor-textarea">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentMonoFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="23.8" />
    <Setter Property="CaretBrush" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource MmAccentSoftBrush}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="TextBox.mm-editor-textarea /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.mm-editor-textarea:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.mm-editor-textarea:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.mm-editor-textarea /template/ TextPresenter#PART_TextPresenter">
    <Setter Property="Margin" Value="36,28,36,28" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="GridSplitter.mm-editor-splitter">
    <Setter Property="Width" Value="9" />
    <Setter Property="Margin" Value="-4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border Width="1"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource MmBorderBrush}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.mm-editor-splitter:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
  </Style>
  <Style Selector="GridSplitter.mm-editor-splitter.dragging /template/ Border">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
  </Style>

  <!-- Разделитель сайдбара своей линии не рисует: он лежит в колонке шириной 0 поверх
       правой границы сайдбара, и в покое видна только она. Отрицательные поля
       раздвигают зону захвата до 9 px с центром на пикселе границы (последнем
       пикселе сайдбара), там же при наведении и перетаскивании загорается акцент. -->
  <Style Selector="GridSplitter.mm-sidebar-splitter">
    <Setter Property="Width" Value="9" />
    <Setter Property="Margin" Value="-5,0,-4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border Width="1"
                  HorizontalAlignment="Center"
                  Background="Transparent" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.mm-sidebar-splitter:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
  </Style>
  <Style Selector="GridSplitter.mm-sidebar-splitter.dragging /template/ Border">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
  </Style>

  <!-- Общая рамка модальных диалогов (ADR-0009 Rule 10). Скрим накрывает всё окно —
       сайдбар, вкладки и строку — и забирает клики; верхние 44 px, место строки окна,
       тянут окно так же, как сама строка. Tab ходит по кругу внутри карточки. -->
  <Style Selector="views|ModalDialogFrame">
    <Setter Property="Background" Value="{DynamicResource MmScrimBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <Border Name="PART_WindowDragArea"
                  Classes="mm-window-drag"
                  Height="44"
                  VerticalAlignment="Top"
                  Background="Transparent" />
          <Border Name="PART_Card"
                  Classes="mm-dialog-card"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  KeyboardNavigation.TabNavigation="Cycle">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Border.mm-dialog-card">
    <Setter Property="Width" Value="440" />
    <Setter Property="Padding" Value="22,22,22,18" />
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="{DynamicResource MmCardShadow}" />
  </Style>

  <!--
    Окно «Настройки» (A-AppSettings) — на той же рамке, карточка шире: 480 px,
    шапка 52 px, строки настроек 52 px с линией между ними и строка версии со ссылками
    внизу под своей линией.
  -->
  <Style Selector="views|ModalDialogFrame.mm-app-settings /template/ Border#PART_Card">
    <Setter Property="Width" Value="480" />
    <Setter Property="Padding" Value="22,0,22,18" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Grid.mm-app-settings-head">
    <Setter Property="Height" Value="52" />
    <Setter Property="Margin" Value="0,0,-10,0" />
  </Style>

  <Style Selector="StackPanel.mm-app-settings-hint">
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="StackPanel.mm-app-settings-hint > TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>

  <Style Selector="Border.mm-app-settings-aa">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="Border.mm-app-settings-aa > views|LucideIcon">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.mm-app-settings-row">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
  </Style>
  <!-- Под последней строкой линию даёт футер, своя у неё сложилась бы с ней в двойную -->
  <Style Selector="Border.mm-app-settings-row.mm-app-settings-row-last">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBlock.mm-app-settings-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="TextBlock.mm-app-settings-caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>

  <Style Selector="Border.mm-app-settings-footer">
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="Padding" Value="0,14,0,0" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
  </Style>

  <Style Selector="TextBlock.mm-dialog-title">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mm-dialog-body">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>

  <Style Selector="Border.mm-dialog-error-shell">
    <Setter Property="Background" Value="{DynamicResource MmAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,14,0,0" />
  </Style>

  <Style Selector="views|LucideIcon.mm-dialog-error-icon">
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>

  <Style Selector="TextBlock.mm-dialog-error">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Ряд кнопок диалога. Порядок задаёт платформа (ADR-0009 Rule 10): кнопки встают
       в колонки, которые им назначает view model, а пустая колонка-распорка отделяет
       «Не сохранять» на macOS от остальных. -->
  <Style Selector="Grid.mm-dialog-buttons">
    <Setter Property="Margin" Value="0,20,0,0" />
    <Setter Property="ColumnSpacing" Value="8" />
  </Style>

  <!-- Плашка с иконкой вида ошибки над заголовком -->
  <Style Selector="Border.mm-error-badge">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource MmTabBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- Крупный значок (24 px) рисуется тоньше остальных: при обводке 1.75 он
       выглядел бы жирнее иконок кнопок -->
  <Style Selector="Border.mm-error-badge views|LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.mm-md-heading">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="SelectableTextBlock.mm-md-heading">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mm-md-paragraph">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="SelectableTextBlock.mm-md-paragraph">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Маркеры списка — цветом текста -->
  <Style Selector="TextBlock.mm-md-list-bullet">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <!--
    Цитата: тёплая плашка, полоса слева и значок кавычек. Поля, скругление и
    место значка задаёт MarkdownDocumentView по MarkdownDocumentMetrics.
  -->
  <Style Selector="Border.mm-md-quote">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmQuoteMarkBrush}" />
    <Setter Property="Background" Value="{DynamicResource MmQuoteBackgroundBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-quote-mark">
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Data" Value="{DynamicResource LucideQuoteGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmQuoteMarkBrush}" />
  </Style>

  <!-- Цитата внутри цитаты: только полоса, без плашки и значка -->
  <Style Selector="Border.mm-md-quote.mm-md-quote-nested">
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmQuoteBarBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!--
    GitHub alert (> [!NOTE] и др.) — плашка цвета вида без полосы, иконка того же
    цвета. Классы вида ставит MarkdownDocumentView, он же красит заголовок тем же
    ресурсом (заголовок — фрагмент текстового потока, а не TextBlock).
  -->
  <Style Selector="Border.mm-md-quote.mm-md-alert">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon">
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="Border.mm-md-quote.mm-md-alert-note">
    <Setter Property="Background" Value="{DynamicResource MmAlertNoteBackgroundBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon.mm-md-alert-note">
    <Setter Property="Data" Value="{DynamicResource LucideInfoGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAlertNoteBrush}" />
  </Style>
  <Style Selector="Border.mm-md-quote.mm-md-alert-tip">
    <Setter Property="Background" Value="{DynamicResource MmAlertTipBackgroundBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon.mm-md-alert-tip">
    <Setter Property="Data" Value="{DynamicResource LucideLightbulbGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAlertTipBrush}" />
  </Style>
  <Style Selector="Border.mm-md-quote.mm-md-alert-important">
    <Setter Property="Background" Value="{DynamicResource MmAlertImportantBackgroundBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon.mm-md-alert-important">
    <Setter Property="Data" Value="{DynamicResource LucideMessageSquareWarningGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAlertImportantBrush}" />
  </Style>
  <Style Selector="Border.mm-md-quote.mm-md-alert-warning">
    <Setter Property="Background" Value="{DynamicResource MmAlertWarningBackgroundBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon.mm-md-alert-warning">
    <Setter Property="Data" Value="{DynamicResource LucideTriangleAlertGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAlertWarningBrush}" />
  </Style>
  <Style Selector="Border.mm-md-quote.mm-md-alert-caution">
    <Setter Property="Background" Value="{DynamicResource MmAlertCautionBackgroundBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon.mm-md-alert-caution">
    <Setter Property="Data" Value="{DynamicResource LucideOctagonAlertGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAlertCautionBrush}" />
  </Style>

  <Style Selector="Border.mm-md-hr">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource MmBorderBrush}" />
  </Style>

  <!--
    Блок документа, который листается вбок (таблица, блок кода, диаграмма):
    горизонтальная полоса видна и в покое, пока содержимое не помещается, —
    подсказка, что блок можно листать. Вертикальную прокрутку документа человек
    ожидает и так, поэтому остальные полосы скрываются (Themes/ScrollBar.axaml).
  -->
  <Style Selector="ScrollViewer.mm-scrollbar-persistent /template/ ScrollBar#PART_HorizontalScrollBar /template/ Thumb">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Блок кода — лист с рамкой; поля и скругление в em задаёт MarkdownDocumentView -->
  <Style Selector="Border.mm-md-codeblock">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource MmCodeBlockBackgroundBrush}" />
  </Style>

  <Style Selector="Button.mm-code-copy-button views|LucideIcon">
    <Setter Property="Data" Value="{DynamicResource LucideCopyGeometry}" />
  </Style>

  <!-- После копирования иконка ненадолго сменяется галочкой (класс ставит MarkdownDocumentView). -->
  <Style Selector="Button.mm-code-copy-button.copied views|LucideIcon">
    <Setter Property="Data" Value="{DynamicResource LucideCheckGeometry}" />
  </Style>

  <Style Selector="TextBlock.mm-md-code-info">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
  </Style>

  <Style Selector="TextBlock.mm-md-codeblock-text">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="SelectableTextBlock.mm-md-codeblock-text">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="Border.mm-md-table">
    <!--
      No outer frame: the grid is drawn by the cells themselves. Padding and the
      per-cell border sides are set in code (MarkdownDocumentView.AddTableRow).
    -->
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="Border.mm-md-table-header-cell">
    <Setter Property="Background" Value="{DynamicResource MmQuoteBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
  </Style>

  <Style Selector="Border.mm-md-table-cell">
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
  </Style>

  <!-- Front matter: lines above and below, none between the rows. -->
  <Style Selector="Border.mm-md-front-matter">
    <Setter Property="BorderThickness" Value="0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
  </Style>

  <Style Selector="TextBlock.mm-md-front-matter-key">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mm-md-front-matter-value">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mm-md-table-header">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="SelectableTextBlock.mm-md-table-header">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mm-md-table-text">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="SelectableTextBlock.mm-md-table-text">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="HyperlinkButton.mm-md-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="TextBlock.mm-md-link-text">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <Style Selector="HyperlinkButton.mm-md-link:pointerover TextBlock.mm-md-link-text">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="Underline.mm-md-link-fallback">
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
  </Style>

  <Style Selector="Span.mm-md-code-inline">
    <Setter Property="Background" Value="{DynamicResource MmCodeBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <!-- Подпись картинки из alt; размеры в em задаёт MarkdownImageView -->
  <Style Selector="TextBlock.mm-md-image-caption">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>

  <!-- Mermaid-диаграмма: подложка из темы, в тёмной — светлый лист (ADR-0005 Decision 12) -->
  <Style Selector="Border.mm-md-diagram-success">
    <Setter Property="Background" Value="{DynamicResource MmDiagramBackgroundBrush}" />
  </Style>

  <!--
    «Место под картинку» — пунктирная рамка битой или загружающейся картинки и
    неудавшейся диаграммы (MarkdownMissingContentFrame): иконка и сообщение
    приглушённым, подпись и заголовок мягким цветом.
  -->
  <Style Selector="Rectangle.mm-md-missing-frame">
    <Setter Property="Stroke" Value="{DynamicResource MmKeyboardBorderBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-missing-icon">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-image-missing-icon">
    <Setter Property="Data" Value="{DynamicResource LucideImageOffGeometry}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-diagram-error-icon">
    <Setter Property="Data" Value="{DynamicResource LucideCircleAlertGeometry}" />
  </Style>
  <Style Selector="TextBlock.mm-md-image-missing-text, TextBlock.mm-md-diagram-error-title">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="TextBlock.mm-md-image-missing-path, TextBlock.mm-md-diagram-error-message">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>

  <!--
    Кольцо прогресса (Views/ProgressRing): без доли четверть круга крутится — оборот
    за 0,9 с, как у системных индикаторов. Поворот анимируется у RotateTransform, который
    каждое кольцо заводит себе само: общий из сеттера стиля делили бы все кольца сразу.
  -->
  <Style Selector="views|ProgressRing:indeterminate">
    <Style.Animations>
      <Animation Duration="0:0:0.9"
                 IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>
