<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             xmlns:views="using:MarkMello.Presentation.Views"
             mc:Ignorable="d"
             x:Class="MarkMello.Presentation.Views.ReadingSettingsPanelView"
             ClipToBounds="False"
             x:DataType="vm:ShellViewModel">
      <!-- Карточка Aa по A-SetAa: тема, шрифт, размер и остальное чтение в одном месте -->
      <Border Classes="mm-settings-panel mm-popover-right mm-reading-panel mm-view-card"
              Width="312">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Classes="mm-card-label"
                       Text="{Binding ReadingThemeLabel}" />
            <Border Classes="mm-card-segments">
              <Grid ColumnDefinitions="*,*,*"
                    ColumnSpacing="2">
                <ToggleButton Grid.Column="0"
                              Classes="mm-card-segment"
                              IsChecked="{Binding IsSystemThemeSelected}">
                  <StackPanel Orientation="Horizontal"
                              Spacing="5">
                    <views:LucideIcon Data="{DynamicResource LucideMonitorGeometry}"
                                      Width="14"
                                      Height="14" />
                    <TextBlock Text="{Binding ReadingThemeAuto}" />
                  </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Column="1"
                              Classes="mm-card-segment"
                              IsChecked="{Binding IsLightThemeSelected}">
                  <StackPanel Orientation="Horizontal"
                              Spacing="5">
                    <views:LucideIcon Data="{DynamicResource LucideSunGeometry}"
                                      Width="14"
                                      Height="14" />
                    <TextBlock Text="{Binding ReadingThemeLight}" />
                  </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Column="2"
                              Classes="mm-card-segment"
                              IsChecked="{Binding IsDarkThemeSelected}">
                  <StackPanel Orientation="Horizontal"
                              Spacing="5">
                    <views:LucideIcon Data="{DynamicResource LucideMoonGeometry}"
                                      Width="14"
                                      Height="14" />
                    <TextBlock Text="{Binding ReadingThemeDark}" />
                  </StackPanel>
                </ToggleButton>
              </Grid>
            </Border>
          </StackPanel>

          <!-- Каждый вариант шрифта набран своей гарнитурой -->
          <StackPanel Spacing="6">
            <TextBlock Classes="mm-card-label"
                       Text="{Binding ReadingFontLabel}" />
            <Border Classes="mm-card-segments">
              <Grid ColumnDefinitions="*,*,*"
                    ColumnSpacing="2">
                <ToggleButton Grid.Column="0"
                              Classes="mm-card-segment"
                              IsChecked="{Binding IsSerifFontSelected}">
                  <TextBlock Text="{Binding ReadingFontSerif}"
                             FontFamily="{DynamicResource MmDocumentSerifFontFamily}"
                             FontSize="13" />
                </ToggleButton>
                <ToggleButton Grid.Column="1"
                              Classes="mm-card-segment"
                              IsChecked="{Binding IsSansFontSelected}">
                  <TextBlock Text="{Binding ReadingFontSans}"
                             FontFamily="{DynamicResource MmDocumentSansFontFamily}" />
                </ToggleButton>
                <ToggleButton Grid.Column="2"
                              Classes="mm-card-segment"
                              IsChecked="{Binding IsMonoFontSelected}">
                  <TextBlock Text="{Binding ReadingFontMono}"
                             FontFamily="{DynamicResource MmDocumentMonoFontFamily}"
                             FontSize="11.5" />
                </ToggleButton>
              </Grid>
            </Border>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="12"
                MinHeight="32">
            <TextBlock Grid.Column="0"
                       Classes="mm-card-label"
                       Text="{Binding ReadingSizeLabel}" />
            <Border Grid.Column="1"
                    Classes="mm-card-stepper">
              <StackPanel Orientation="Horizontal"
                          Spacing="2">
                <Button Classes="mm-icon-button mm-icon-button-raised mm-card-step"
                        Command="{Binding DecreaseTextSizeCommand}"
                        ToolTip.Tip="{Binding ReadingSizeDecreaseTooltip}">
                  <views:LucideIcon Data="{DynamicResource LucideMinusGeometry}"
                                    Width="14"
                                    Height="14" />
                </Button>
                <TextBlock Classes="mm-card-step-value"
                           Text="{Binding FontSizeLabel}" />
                <Button Classes="mm-icon-button mm-icon-button-raised mm-card-step"
                        Command="{Binding IncreaseTextSizeCommand}"
                        ToolTip.Tip="{Binding ReadingSizeIncreaseTooltip}">
                  <views:LucideIcon Data="{DynamicResource LucidePlusGeometry}"
                                    Width="14"
                                    Height="14" />
                </Button>
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Classes="mm-card-label"
                         Text="{Binding ReadingLineHeightLabel}" />
              <TextBlock Grid.Column="1"
                         Classes="mm-card-value"
                         Text="{Binding LineHeightLabel}" />
            </Grid>
            <Slider Classes="mm-settings-slider mm-card-slider"
                    Minimum="1.4"
                    Maximum="2.0"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    Value="{Binding LineHeightSetting, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="mm-card-label"
                       Text="{Binding ReadingWidthLabel}" />
            <Border Classes="mm-card-segments">
              <Grid ColumnDefinitions="*,*,*"
                    ColumnSpacing="2">
                <ToggleButton Grid.Column="0"
                              Classes="mm-card-segment"
                              IsChecked="{Binding IsNarrowWidthSelected}">
                  <TextBlock Text="{Binding ReadingWidthNarrow}" />
                </ToggleButton>
                <ToggleButton Grid.Column="1"
                              Classes="mm-card-segment"
                              IsChecked="{Binding IsMediumWidthSelected}">
                  <TextBlock Text="{Binding ReadingWidthMedium}" />
                </ToggleButton>
                <ToggleButton Grid.Column="2"
                              Classes="mm-card-segment"
                              IsChecked="{Binding IsWideWidthSelected}">
                  <TextBlock Text="{Binding ReadingWidthWide}" />
                </ToggleButton>
              </Grid>
            </Border>
          </StackPanel>

          <!--
            Строка ведёт в окно «Настройки» (ADR-0009 Rule 5). Зазоры 4, а не 8 из
            макета: с плашками «⌘» «,» английской подсказке в Inter иначе не хватает
            места. Русская на macOS и любая с «Ctrl» «,» (Windows, Linux) не
            помещается и так — тогда она не рисуется совсем, а не обрывается на
            полуслове.
          -->
          <Button Classes="mm-list-item mm-card-footer"
                  Command="{Binding OpenAppSettingsCommand}">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="4">
              <views:OptionalTextBlock Grid.Column="0"
                                       Text="{Binding ReadingMoreSettingsHint}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Classes="mm-card-footer-link"
                         Text="{Binding ReadingMoreSettingsLink}" />
              <ItemsControl Grid.Column="2"
                            Classes="mm-shortcut-keys"
                            ItemsSource="{Binding SettingsShortcutKeys}" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
</UserControl>
