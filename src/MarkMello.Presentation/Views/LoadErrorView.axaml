<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             xmlns:views="using:MarkMello.Presentation.Views"
             mc:Ignorable="d"
             x:Class="MarkMello.Presentation.Views.LoadErrorView"
             x:DataType="vm:ShellViewModel">

  <!-- Экран ошибки открытия (A-LoadError): иконка вида ошибки, заголовок, пояснение,
       путь, который можно скопировать, и выход — другой файл, повтор или Esc. -->
  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520"
                Margin="16,0,16,64"
                AutomationProperties.LiveSetting="Assertive">

      <Border Classes="mm-error-badge">
        <Panel>
          <views:LucideIcon Data="{DynamicResource LucideFileXGeometry}"
                            Width="24"
                            Height="24"
                            IsVisible="{Binding IsNotFoundError}" />
          <views:LucideIcon Data="{DynamicResource LucideLockGeometry}"
                            Width="24"
                            Height="24"
                            IsVisible="{Binding IsAccessDeniedError}" />
          <views:LucideIcon Data="{DynamicResource LucideFileQuestionMarkGeometry}"
                            Width="24"
                            Height="24"
                            IsVisible="{Binding IsUnsupportedTypeError}" />
          <views:LucideIcon Data="{DynamicResource LucideCircleAlertGeometry}"
                            Width="24"
                            Height="24"
                            IsVisible="{Binding IsGenericError}" />
        </Panel>
      </Border>

      <TextBlock Text="{Binding ErrorTitle}"
                 Margin="0,18,0,0"
                 FontFamily="{DynamicResource MmDocumentSerifFontFamily}"
                 FontSize="26"
                 LineHeight="32"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource MmTextBrush}" />

      <TextBlock Text="{Binding ErrorDescription}"
                 IsVisible="{Binding HasErrorDescription}"
                 Margin="0,8,0,0"
                 FontSize="13.5"
                 LineHeight="21"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource MmTextSoftBrush}" />

      <!-- Путь выделяется и копируется: с ним идут в терминал или в Finder. -->
      <Border IsVisible="{Binding HasErrorPath}"
              Margin="0,14,0,0"
              Padding="10,6"
              CornerRadius="7"
              HorizontalAlignment="Center"
              Background="{DynamicResource MmCodeBackgroundBrush}">
        <SelectableTextBlock Text="{Binding ErrorPath}"
                             FontFamily="{DynamicResource MmDocumentMonoFontFamily}"
                             FontSize="12"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             Foreground="{DynamicResource MmTextSoftBrush}" />
      </Border>

      <StackPanel Orientation="Horizontal"
                  Spacing="8"
                  Margin="0,26,0,0"
                  HorizontalAlignment="Center">
        <Button Classes="mm-action-primary mm-action-large"
                Content="{Binding LoadErrorOpenAnotherFile}"
                Command="{Binding OpenFileCommand}" />
        <Button Classes="mm-action-secondary mm-action-large"
                IsVisible="{Binding ShowsLoadErrorRetry}"
                Content="{Binding LoadErrorTryAgain}"
                Command="{Binding RetryLoadCommand}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal"
                  Spacing="6"
                  Margin="0,22,0,0"
                  HorizontalAlignment="Center">
        <ItemsControl Classes="mm-shortcut-keys"
                      ItemsSource="{Binding DialogCancelShortcutKeys}" />
        <TextBlock Text="{Binding LoadErrorDismiss}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource MmTextSoftBrush}" />
      </StackPanel>

    </StackPanel>
  </Grid>

</UserControl>
