<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             xmlns:views="using:MarkMello.Presentation.Views"
             mc:Ignorable="d"
             x:Class="MarkMello.Presentation.Views.EditWorkspaceView"
             x:DataType="vm:EditorSessionViewModel">

  <Grid Name="EditGrid"
        ClipToBounds="True">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"
                        MinWidth="280" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="*"
                        MinWidth="280" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Classes="mm-editor-pane">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Classes="mm-editor-toolbar">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="2">
              <Button Classes="mm-icon-button mm-editor-toolbar-button"
                      Tag="Bold"
                      Click="OnFormatButtonClick"
                      ToolTip.Tip="{Binding EditorBoldTooltip}">
                <views:LucideIcon Data="{DynamicResource LucideBoldGeometry}"
                                  Width="14"
                                  Height="14" />
              </Button>
              <Button Classes="mm-icon-button mm-editor-toolbar-button"
                      Tag="Italic"
                      Click="OnFormatButtonClick"
                      ToolTip.Tip="{Binding EditorItalicTooltip}">
                <views:LucideIcon Data="{DynamicResource LucideItalicGeometry}"
                                  Width="14"
                                  Height="14" />
              </Button>
              <Button Classes="mm-icon-button mm-editor-toolbar-button"
                      Tag="Code"
                      Click="OnFormatButtonClick"
                      ToolTip.Tip="{Binding EditorCodeTooltip}">
                <views:LucideIcon Data="{DynamicResource LucideCodeGeometry}"
                                  Width="14"
                                  Height="14" />
              </Button>
              <Border Classes="mm-editor-toolbar-separator" />
              <Button Classes="mm-icon-button mm-editor-toolbar-button"
                      Tag="Link"
                      Click="OnFormatButtonClick"
                      ToolTip.Tip="{Binding EditorLinkTooltip}">
                <views:LucideIcon Data="{DynamicResource LucideLinkGeometry}"
                                  Width="14"
                                  Height="14" />
              </Button>
              <Button Classes="mm-icon-button mm-editor-toolbar-button"
                      Tag="List"
                      Click="OnFormatButtonClick"
                      ToolTip.Tip="{Binding EditorListTooltip}">
                <views:LucideIcon Data="{DynamicResource LucideListGeometry}"
                                  Width="14"
                                  Height="14" />
              </Button>
              <Button Classes="mm-icon-button mm-editor-toolbar-button"
                      Tag="Quote"
                      Click="OnFormatButtonClick"
                      ToolTip.Tip="{Binding EditorQuoteTooltip}">
                <views:LucideIcon Data="{DynamicResource LucideTextQuoteGeometry}"
                                  Width="14"
                                  Height="14" />
              </Button>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Classes="mm-editor-toolbar-label"
                       Text="{Binding EditorSourceLabel}" />
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <TextBox Name="EditorTextBox"
                   Classes="mm-editor-textarea"
                   AcceptsReturn="True"
                   AcceptsTab="True"
                   NewLine="{Binding DocumentNewLine}"
                   TextWrapping="Wrap"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   KeyDown="OnEditorKeyDown"
                   TextInput="OnEditorTextInput"
                   Text="{Binding SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

          <Border Classes="mm-editor-status-shell"
                  IsVisible="{Binding HasStatusMessage}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  Margin="18,12,18,0"
                  ZIndex="1">
            <TextBlock Classes="mm-editor-status-text"
                       Text="{Binding StatusMessage}" />
          </Border>
        </Grid>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1"
                  Name="EditorSplitter"
                  Classes="mm-editor-splitter"
                  ZIndex="2"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  PointerPressed="OnSplitterPointerPressed"
                  PointerReleased="OnSplitterPointerReleased"
                  PointerCaptureLost="OnSplitterPointerCaptureLost"
                  DragCompleted="OnSplitterDragCompleted" />

    <!-- Предпросмотр подписан полосой той же высоты, что панель инструментов слева:
         обе панели начинаются с подписи на одной линии, над текстом ничего не плавает. -->
    <Grid Grid.Column="2"
          MinWidth="280"
          RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Classes="mm-editor-toolbar mm-editor-preview-toolbar">
        <TextBlock Classes="mm-editor-toolbar-label"
                   Text="{Binding EditorPreviewLabel}" />
      </Border>

      <ScrollViewer Name="PreviewScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    UseLayoutRounding="True">
        <Grid UseLayoutRounding="True">
          <Border MaxWidth="{Binding DocumentColumnMaxWidth}"
                  HorizontalAlignment="Center"
                  UseLayoutRounding="True">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="MaxWidth"
                                  Duration="0:0:0.18" />
              </Transitions>
            </Border.Transitions>
            <views:MarkdownDocumentView Name="PreviewDocumentView"
                                        Document="{Binding RenderedPreview}"
                                        DocumentPadding="72,96,72,160"
                                        ReadingPreferences="{Binding ReadingPreferences}"
                                        ImageSourceResolver="{Binding ImageSourceResolver}"
                                        UseLayoutRounding="True" />
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>

  </Grid>
</UserControl>
