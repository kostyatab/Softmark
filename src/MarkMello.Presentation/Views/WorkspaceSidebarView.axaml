<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             xmlns:ws="using:MarkMello.Domain.Workspace"
             xmlns:views="using:MarkMello.Presentation.Views"
             mc:Ignorable="d"
             x:Class="MarkMello.Presentation.Views.WorkspaceSidebarView"
             x:DataType="vm:ShellViewModel">

  <!-- Стили самого сайдбара живут здесь, а не в глобальном словаре: в single-file
       режиме этот контрол не создаётся, и парсить их незачем. Роли кнопок
       («имя папки ▾», находки поиска, кнопки шапки) — в Themes/Controls.axaml:
       они общие со строкой окна и меню. -->
  <UserControl.Styles>
    <!-- ======================= Сайдбар открытой папки ======================= -->

    <!-- Сетка краёв, общая со строкой окна: подложки кнопок и строки дерева в 11px
         от краёв, иконки и текст в 19px — на одной вертикали с красной кнопкой
         светофора macOS. Поле поиска видно всегда, поэтому его рамка стоит по краям
         светофора и иконок, в 19px. Слева и справа отступы одинаковые. -->

    <Style Selector="Border.mm-sidebar">
      <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!-- Иконки подписи не перекрашиваются: наведение показывает только фон.
         Цвет стоит на самих иконках — Foreground кнопки Fluent меняет по состояниям. -->
    <Style Selector="Button.mm-sidebar-folder views|LucideIcon">
      <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    </Style>

    <Style Selector="TextBlock.mm-sidebar-root">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TreeView.mm-tree">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="11,2,11,12" />
      <!-- Без виртуализации каталог на 5000 элементов реализует 5000 строк:
           замер давал 11 с на раскрытие и 939 МБ рабочего множества. -->
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>

    <Style Selector="TreeView.mm-tree TreeViewItem">
      <!-- Без этой связки шеврон раскрывает только контейнер: view-model не узнаёт
           о раскрытии, каталог не читается, и под папкой остаётся пустая строка-заглушка. -->
      <Setter Property="IsExpanded"
              Value="{CompiledBinding IsExpanded, Mode=TwoWay, DataType=vm:FileTreeNodeViewModel}" />
      <!-- Заливку текущего файла рисует шаблон контейнера, куда класс из шаблона
           данных не дотягивается: признак переносится на контейнер свойством. -->
      <Setter Property="views:WorkspaceSidebarView.IsActiveRow"
              Value="{CompiledBinding IsActiveDocument, DataType=vm:FileTreeNodeViewModel}" />
      <Setter Property="views:WorkspaceSidebarView.IsPendingDeleteRow"
              Value="{CompiledBinding IsPendingDelete, DataType=vm:FileTreeNodeViewModel}" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
      <!-- Тот же панельный шаблон для вложенных уровней: раскрытый большой каталог
           не должен стоить дороже корневого. -->
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>

    <!-- Отступ строки: 8px у корня — шеврон встаёт на вертикаль иконок сайдбара, —
         место под шеврон 12px с щелью 6px в каждой строке, чтобы иконки файлов
         стояли ровно под иконками папок того же уровня. Вложенность отступает сам
         Fluent, по 16px на уровень; свой отступ на уровень здесь его удваивал. -->
    <Style Selector="TreeView.mm-tree TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="Width" Value="18" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <!-- Шеврон Lucide вместо залитого глифа Fluent: тот же ToggleButton (мышь и
         клавиатура раскрывают папку как раньше), другой шаблон. Цвет — тот, каким
         Fluent красит свой шеврон; раскрытая папка поворачивает его вниз. -->
    <Style Selector="TreeView.mm-tree TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <views:LucideIcon Data="{DynamicResource LucideChevronRightGeometry}"
                              Foreground="{DynamicResource MmTextFaintBrush}"
                              Width="12"
                              Height="12" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TreeView.mm-tree TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:checked /template/ views|LucideIcon">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>

    <!-- Выделение и наведение: без этого TreeViewItem красится системным акцентом,
         который в тёплой палитре выглядит инородным фиолетовым пятном. -->
    <Style Selector="TreeView.mm-tree TreeViewItem /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7" />
      <!-- Рамка есть у каждой строки, прозрачная: подсветка удаляемой меняет только её
           цвет, и имя в строке не сдвигается на пиксель, пока открыт диалог. -->
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TreeView.mm-tree TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    </Style>
    <Style Selector="TreeView.mm-tree TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    </Style>
    <Style Selector="TreeView.mm-tree TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    </Style>
    <!-- Текущий файл — заливка вместо полоски (ADR-0009 Rule 1). Ниже наведения
         и выделения, чтобы держаться и под курсором. -->
    <Style Selector="TreeView.mm-tree TreeViewItem[(views|WorkspaceSidebarView.IsActiveRow)=True] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MmTabActiveBrush}" />
    </Style>
    <!-- Удаляемая строка (A-Delete): пока открыт диалог, она подсвечена заливкой наведения
         и рамкой — меню уже закрылось, а видеть, о чём вопрос, надо. Стоит после стиля
         текущего файла и перекрывает его: удалить можно и открытый. -->
    <Style Selector="TreeView.mm-tree TreeViewItem[(views|WorkspaceSidebarView.IsPendingDeleteRow)=True] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    </Style>
    <Style Selector="TreeView.mm-tree TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TextBlock.mm-tree-label">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Не-документ: показан, но не открывается -->
    <Style Selector="TextBlock.mm-tree-label.inert">
      <Setter Property="Foreground" Value="{DynamicResource MmTreeInertTextBrush}" />
    </Style>
    <!-- Иконка строки: папка закрытая или открытая, документ, прочий файл. Иконку
         текущего файла выделяет акцент, не-документ — тот же приглушённый цвет,
         что и его имя. -->
    <Style Selector="views|LucideIcon.mm-tree-icon">
      <Setter Property="Data" Value="{DynamicResource LucideFileGeometry}" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="views|LucideIcon.mm-tree-icon.document">
      <Setter Property="Data" Value="{DynamicResource LucideFileTextGeometry}" />
    </Style>
    <Style Selector="views|LucideIcon.mm-tree-icon.folder">
      <Setter Property="Data" Value="{DynamicResource LucideFolderGeometry}" />
    </Style>
    <Style Selector="views|LucideIcon.mm-tree-icon.folder.open">
      <Setter Property="Data" Value="{DynamicResource LucideFolderOpenGeometry}" />
    </Style>
    <Style Selector="views|LucideIcon.mm-tree-icon.inert">
      <Setter Property="Foreground" Value="{DynamicResource MmTreeInertTextBrush}" />
    </Style>
    <Style Selector="views|LucideIcon.mm-tree-icon.active">
      <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.mm-tree-label.active">
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    </Style>

    <Style Selector="TextBlock.mm-tree-error">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ======================= Поиск в сайдбаре ======================= -->

    <Style Selector="Border.mm-search-shell">
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="19,0,19,10" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{DynamicResource MmBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- Активный поиск обводится акцентом: дерево в этот момент скрыто, и это единственный признак -->
    <Style Selector="Border.mm-search-shell.active">
      <Setter Property="BorderBrush" Value="{DynamicResource MmAccentBrush}" />
    </Style>
    <Style Selector="Border.mm-search-shell views|LucideIcon">
      <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    </Style>
    <Style Selector="Border.mm-search-shell.active views|LucideIcon">
      <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    </Style>

    <Style Selector="TextBox.mm-search-input">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource MmTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Рамку рисует контейнер поля. Без этих трёх правил Fluent подставляет
         на фокусе и наведении системный акцент вместо палитры приложения. -->
    <Style Selector="TextBox.mm-search-input /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.mm-search-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.mm-search-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Шапка списка совпадений: дерево в этот момент скрыто, и список надо назвать -->
    <Style Selector="TextBlock.mm-search-caption">
      <Setter Property="Margin" Value="19,2,19,4" />
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    </Style>

    <Style Selector="TextBlock.mm-search-count">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentMonoFontFamily}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.mm-search-hit-path">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    </Style>

    <Style Selector="TextBlock.mm-search-empty">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Margin" Value="19,0" />
    </Style>

    <!-- Папка без документов (A-EmptyFolder): строка на месте поиска, на вертикали иконок -->
    <Style Selector="TextBlock.mm-sidebar-no-documents">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="19,4,19,10" />
    </Style>

    <!-- Обрезанная выдача обязана быть видна: иначе 200 совпадений выглядят полным ответом -->
    <Style Selector="Border.mm-search-truncated">
      <Setter Property="Background" Value="{DynamicResource MmSurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="19,8" />
    </Style>
    <Style Selector="Border.mm-search-truncated TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    </Style>

    <Style Selector="Border.mm-sidebar-footer">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="19,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.mm-sidebar-footer TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentMonoFontFamily}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ======================= Операции в дереве ======================= -->

    <!-- Инлайн-ввод имени встаёт в дерево, а не в диалог: видно, куда попадёт элемент -->
    <Style Selector="TextBox.mm-tree-edit-input">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SelectionBrush" Value="{DynamicResource MmSelectionBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource MmTextBrush}" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="TextBox.mm-tree-edit-input /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.mm-tree-edit-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.mm-tree-edit-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Ошибочное имя подсвечивается толстой рамкой: BoxShadow у TextBox перекрывается шаблоном -->
    <Style Selector="TextBox.mm-tree-edit-input.invalid /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox.mm-tree-edit-input.invalid:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="TextBlock.mm-tree-edit-error">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="mm-sidebar">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

      <!-- Шапка — продолжение строки окна: пустое место тянет окно, на macOS
           слева стоит светофор. Высоту строки окна, сторону кнопки и отступы
           по платформе ставит code-behind. -->
      <Border Grid.Row="0"
              Name="SidebarHeader"
              Classes="mm-window-drag"
              Background="Transparent">
        <Button Name="SidebarToggleButton"
                Classes="mm-icon-button mm-row-button"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="{Binding SidebarToggleTooltip}">
          <views:LucideIcon Data="{DynamicResource LucidePanelLeftCloseGeometry}"
                            Width="14"
                            Height="14" />
        </Button>
      </Border>

      <!-- «имя папки ▾» — действия над самой папкой, «+» — создание в ней -->
      <Grid Grid.Row="1"
            ColumnDefinitions="*,Auto"
            Margin="11,4,11,8">
        <Button Grid.Column="0"
                Name="FolderMenuButton"
                Classes="mm-list-item mm-sidebar-folder mm-menu-trigger"
                Click="OnFolderMenuButtonClick"
                ToolTip.Tip="{Binding Workspace.Folder.RootPath}">
          <!-- Сетка, а не StackPanel: длинное имя папки обрезается, а не выталкивает шеврон -->
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="7">
            <views:LucideIcon Grid.Column="0"
                              Data="{DynamicResource LucideFolderOpenGeometry}"
                              Width="14"
                              Height="14"
                              VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Classes="mm-sidebar-root"
                       Text="{Binding Workspace.RootDisplayName}" />
            <views:LucideIcon Grid.Column="2"
                              Data="{DynamicResource LucideChevronDownGeometry}"
                              Width="12"
                              Height="12"
                              VerticalAlignment="Center" />
          </Grid>
        </Button>

        <Button Grid.Column="1"
                Name="CreateMenuButton"
                Classes="mm-icon-button mm-row-button mm-menu-trigger"
                Click="OnCreateMenuButtonClick"
                ToolTip.Tip="{Binding SidebarCreateTooltip}">
          <views:LucideIcon Data="{DynamicResource LucidePlusGeometry}"
                            Width="14"
                            Height="14" />
        </Button>
      </Grid>

      <!-- Поиск по именам: поле и лупа получают акцент, пока запрос активен (класс active) -->
      <Border Grid.Row="2"
              Classes="mm-search-shell"
              Classes.active="{Binding Workspace.HasSearchQuery}"
              IsVisible="{Binding !Workspace.ShowsNoDocumentsNote}">
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8">
          <views:LucideIcon Grid.Column="0"
                            Data="{DynamicResource LucideSearchGeometry}"
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center" />

          <!-- Esc вешается в code-behind: TextBox помечает клавишу обработанной,
               и обработчик из разметки до неё не доходит. -->
          <TextBox Grid.Column="1"
                   Name="SearchInput"
                   Classes="mm-search-input"
                   Text="{Binding Workspace.SearchQuery, Mode=TwoWay}"
                   PlaceholderText="{Binding SidebarSearchPlaceholder}" />

          <TextBlock Grid.Column="2"
                     Classes="mm-search-count"
                     IsVisible="{Binding Workspace.HasSearchQuery}"
                     Text="{Binding Workspace.SearchCountLabel}" />
        </Grid>
      </Border>

      <TextBlock Grid.Row="2"
                 Name="NoDocumentsNote"
                 Classes="mm-sidebar-no-documents"
                 IsVisible="{Binding Workspace.ShowsNoDocumentsNote}"
                 Text="{Binding SidebarNoDocuments}" />

      <!-- Строки не уезжают за правый край: без этого поле ввода и сообщение об ошибке
           растягивают дерево по ширине текста и обрезаются краем сайдбара. -->
      <TreeView Grid.Row="3"
                Name="FileTree"
                Classes="mm-tree"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                KeyDown="OnTreeKeyDown"
                IsVisible="{Binding Workspace.ShowsTree}"
                ItemsSource="{Binding Workspace.Roots}"
                SelectedItem="{Binding Workspace.SelectedNode, Mode=TwoWay}">
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="vm:FileTreeNodeViewModel"
                            ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="6"
                  Background="Transparent">
              <views:LucideIcon Grid.Column="0"
                                Classes="mm-tree-icon"
                                Classes.folder="{Binding IsDirectory}"
                                Classes.open="{Binding IsExpanded}"
                                Classes.document="{Binding IsSupportedDocument}"
                                Classes.inert="{Binding IsInert}"
                                Classes.active="{Binding IsActiveDocument}"
                                Width="14"
                                Height="14" />

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="6"
                          IsVisible="{Binding !IsEditing}">
                <TextBlock Classes="mm-tree-label"
                           Classes.inert="{Binding IsInert}"
                           Classes.active="{Binding IsActiveDocument}"
                           Text="{Binding Name}" />
                <TextBlock Classes="mm-tree-error"
                           IsVisible="{Binding HasLoadError}"
                           Text="{Binding LoadError}" />
              </StackPanel>

              <!-- Ввод имени стоит в самой строке, а не отдельной панелью над деревом
                   (макет 09). Content = null, пока строка не редактируется, поэтому
                   поле существует только в одной строке из всех. -->
              <ContentControl Grid.Column="1"
                              Content="{Binding Editor}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:FileTreeNodeViewModel">
                    <StackPanel Spacing="3">
                      <TextBox Classes="mm-tree-edit-input"
                               Classes.invalid="{Binding $parent[TreeView].((vm:ShellViewModel)DataContext).Workspace.HasEditError}"
                               Text="{Binding $parent[TreeView].((vm:ShellViewModel)DataContext).Workspace.EditName, Mode=TwoWay}"
                               AttachedToVisualTree="OnEditNameAttached"
                               LostFocus="OnEditNameLostFocus" />
                      <TextBlock Classes="mm-tree-edit-error"
                                 IsVisible="{Binding $parent[TreeView].((vm:ShellViewModel)DataContext).Workspace.HasEditError}"
                                 Text="{Binding $parent[TreeView].((vm:ShellViewModel)DataContext).Workspace.EditError}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>

              <!-- Несохранённый документ: та же точка, что и во вкладке -->
              <Ellipse Grid.Column="2"
                       IsVisible="{Binding IsDirty}"
                       Width="7"
                       Height="7"
                       Margin="6,0,2,0"
                       VerticalAlignment="Center"
                       Fill="{DynamicResource MmAccentBrush}" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <Grid Grid.Row="3"
            IsVisible="{Binding Workspace.HasSearchQuery}"
            RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Classes="mm-search-caption"
                   IsVisible="{Binding Workspace.HasSearchHits}"
                   Text="{Binding SidebarSearchMatches}" />

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Workspace.SearchHits}"
                        Margin="11,2,11,12">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ws:WorkspaceSearchHit">
                <Button Classes="mm-list-item mm-search-hit"
                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).Workspace.ActivateSearchHitCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Spacing="1">
                    <!-- Подсвечена только совпавшая часть имени. Переносы между Run
                         превращаются в пробелы и разрывают имя, поэтому они в одну строку. -->
                    <TextBlock Classes="mm-tree-label"><Run Text="{Binding NameBeforeMatch}" /><Run Text="{Binding MatchedName}" Background="{DynamicResource MmAccentSoftBrush}" Foreground="{DynamicResource MmAccentBrush}" /><Run Text="{Binding NameAfterMatch}" /></TextBlock>
                    <TextBlock Classes="mm-search-hit-path"
                               IsVisible="{Binding HasRelativeDirectory}"
                               Text="{Binding RelativeDirectory}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="0"
                   Grid.RowSpan="2"
                   Classes="mm-search-empty"
                   IsVisible="{Binding Workspace.ShowsSearchEmptyState}"
                   Text="{Binding SidebarSearchEmpty}" />
      </Grid>

      <!-- Подвал: в поиске — неполная выдача и подсказка про Esc -->
      <StackPanel Grid.Row="4">
        <Border Classes="mm-search-truncated"
                IsVisible="{Binding Workspace.IsSearchTruncated}">
          <TextBlock Text="{Binding SidebarSearchTruncated}"
                     TextWrapping="Wrap" />
        </Border>
        <Border Classes="mm-sidebar-footer"
                IsVisible="{Binding Workspace.HasSearchQuery}">
          <TextBlock Text="{Binding SidebarSearchReset}" />
        </Border>
      </StackPanel>
    </Grid>
  </Border>

</UserControl>
