<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MarkMello.Presentation.ViewModels"
        xmlns:views="using:MarkMello.Presentation.Views"
        mc:Ignorable="d"
        x:Class="MarkMello.Presentation.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1280" Height="840"
        WindowStartupLocation="CenterScreen"
        MinWidth="640" MinHeight="480"
        Title="{Binding WindowTitle}"
        Icon="/Assets/Icons/softmark.ico"
        Background="{DynamicResource MmBackgroundBrush}"
        DragDrop.AllowDrop="True"
        UseLayoutRounding="True">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ShellViewModel"
                  x:DataType="vm:ShellViewModel">
      <views:ViewerView />
    </DataTemplate>
    <DataTemplate DataType="vm:EditorSessionViewModel"
                  x:DataType="vm:EditorSessionViewModel">
      <views:EditWorkspaceView />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewDocumentCommand}" />
    <KeyBinding Gesture="Cmd+N" Command="{Binding CreateNewDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
    <KeyBinding Gesture="Cmd+O" Command="{Binding OpenFileCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}" />
    <KeyBinding Gesture="Cmd+Shift+O" Command="{Binding OpenFolderCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="Cmd+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
    <KeyBinding Gesture="Cmd+W" Command="{Binding CloseActiveTabCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding ActivateNextTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding ActivatePreviousTabCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ToggleEditModeCommand}" />
    <KeyBinding Gesture="Cmd+E" Command="{Binding ToggleEditModeCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Cmd+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Cmd+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Cmd+R" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleFindBarCommand}" />
    <KeyBinding Gesture="Cmd+F" Command="{Binding ToggleFindBarCommand}" />
    <!-- Размер текста. OemPlus — клавиша «=», с Shift это «+»; Add и Subtract
         с цифрового блока жест сводит к OemPlus и OemMinus сам, а NumPad0 — нет. -->
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding IncreaseTextSizeCommand}" />
    <KeyBinding Gesture="Cmd+OemPlus" Command="{Binding IncreaseTextSizeCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+OemPlus" Command="{Binding IncreaseTextSizeCommand}" />
    <KeyBinding Gesture="Cmd+Shift+OemPlus" Command="{Binding IncreaseTextSizeCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding DecreaseTextSizeCommand}" />
    <KeyBinding Gesture="Cmd+OemMinus" Command="{Binding DecreaseTextSizeCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetTextSizeCommand}" />
    <KeyBinding Gesture="Cmd+D0" Command="{Binding ResetTextSizeCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ResetTextSizeCommand}" />
    <KeyBinding Gesture="Cmd+NumPad0" Command="{Binding ResetTextSizeCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding ClearErrorCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- Строка окна (ADR-0009 Rule 1): фон документа, без текста заголовка. Высоту —
         44 px, на macOS 52 по системному тулбару — ставит code-behind.
         Пустое место строки тянет окно — класс mm-window-drag. -->
    <Style Selector="Border.mm-window-row">
      <Setter Property="Background" Value="{DynamicResource MmBackgroundBrush}" />
    </Style>
    <!-- Линия под строкой, как у тулбаров macOS: лежит поверх нижнего пикселя
         строки и ничего не сдвигает. -->
    <Style Selector="Border.mm-window-row-divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Background" Value="{DynamicResource MmBorderSoftBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- Черта между кнопками строки и кнопками окна Windows -->
    <Style Selector="Border.mm-window-buttons-divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="8,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource MmBorderBrush}" />
    </Style>

    <!-- Плашка счётчика (A-Reading): в правом нижнем углу области документа, на
         непрозрачной подложке фона — текст документа под неё не просвечивает. -->
    <Style Selector="Border.mm-status">
      <Setter Property="Margin" Value="0,0,16,12" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource MmBackgroundBrush}" />
    </Style>
    <Style Selector="Border.mm-status TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    </Style>

    <!-- Полоса «изменён на диске» (A-External): под строкой окна во всю ширину области
         документа — текст под ней остаётся видимым целиком. -->
    <Style Selector="Border.mm-external-change">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="16,0,10,0" />
      <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.mm-external-change TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    </Style>

    <Style Selector="Border.mm-progress">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Width" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.12" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window:pointerover Border.mm-progress">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </Window.Styles>

  <!-- Hairline around the whole window. Without it a light window on a light
       background has no visible edge, so two overlapping documents read as one
       surface. Thickness comes from the code-behind: it depends on the setting,
       the platform and the window state. -->
  <Border Name="WindowBorder"
          BorderBrush="{DynamicResource MmBorderBrush}"
          BorderThickness="0">
    <Grid Name="SidebarLayout">

      <!-- Ширину держит колонка, а не контент: GridSplitter двигает именно колонку,
           и фиксированная ширина сайдбара оставляла бы рядом с ним пустую полосу.
           Диапазон 220-340 из макета, он же в WorkspaceSidebarWidth. Колонка разделителя
           шириной 0: он лежит поверх границы сайдбара и второй линии рядом не рисует. -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="0" MaxWidth="340" />
        <ColumnDefinition Width="0" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ContentControl, а не сам контрол: в single-file режиме сайдбара не должно
           быть в визуальном дереве вообще (ADR-0007 Rule 3). Его шапка — продолжение
           строки окна той же высоты: на macOS в ней светофор, и она тоже тянет окно. -->
      <ContentControl Grid.Column="0"
                      IsVisible="{Binding ShowsSidebar}"
                      Content="{Binding SidebarContent}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:ShellViewModel">
            <views:WorkspaceSidebarView />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <GridSplitter Grid.Column="1"
                    Name="SidebarSplitter"
                    Classes="mm-sidebar-splitter"
                    ZIndex="1"
                    IsVisible="{Binding ShowsSidebar}"
                    DragStarted="OnSidebarSplitterDragStarted"
                    DragCompleted="OnSidebarSplitterDragCompleted"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext" />

      <Grid Grid.Column="2"
            RowDefinitions="Auto,Auto,*">

        <!-- Строка окна: вкладки и постоянный блок кнопок справа вместо тайтлбара
             и строки вкладок (ADR-0009 Rules 1–2). Отступы по краям зависят от
             платформы и сайдбара — их ставит code-behind. -->
        <Border Grid.Row="0"
                Name="WindowRow"
                Classes="mm-window-row mm-window-drag">
          <Grid Name="WindowRowContent"
                ColumnDefinitions="Auto,*,Auto,Auto">

            <!-- Свёрнутый сайдбар возвращается отсюда: без видимой кнопки дерево
                 кажется потерянным. -->
            <Button Grid.Column="0"
                    Classes="mm-icon-button mm-row-button"
                    Margin="0,0,4,0"
                    IsVisible="{Binding ShowsExpandSidebarButton}"
                    Command="{Binding ToggleSidebarCommand}"
                    ToolTip.Tip="{Binding SidebarToggleTooltip}">
              <views:LucideIcon Data="{DynamicResource LucidePanelLeftOpenGeometry}"
                                Width="14"
                                Height="14" />
            </Button>

            <ContentControl Grid.Column="1"
                            IsVisible="{Binding ShowsTabStrip}"
                            Content="{Binding TabStripContent}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ShellViewModel">
                  <views:TabStripView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Кнопки видны всегда, без показа по наведению. Лишние для состояния
                 прячутся: на стартовом экране остаётся одно меню ⋯; в правке нет Aa,
                 а карандаш становится «Готово». -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
              <!-- Кнопка обновления (ADR-0004, «Update Model») — первой, чтобы раскрытая
                   надпись росла влево над вкладками, а не над кнопками. Создаётся, только
                   когда есть новая версия: до этого у ContentControl нет содержимого.
                   Без обрезки: раскрытая плашка шире хоста в 30 px, и по его границам
                   от неё осталась бы одна правая полоса. -->
              <ContentControl Name="UpdateButtonHost"
                              Margin="0,0,2,0"
                              ClipToBounds="False"
                              IsVisible="{Binding Updates.IsButtonVisible}"
                              Content="{Binding Updates.ButtonContent}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:UpdateViewModel">
                    <views:UpdateNotificationButton />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>

              <StackPanel Name="UnsavedIndicator"
                          Orientation="Horizontal"
                          Spacing="7"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          IsVisible="{Binding ShowsUnsavedIndicator}">
                <TextBlock Classes="mm-row-status"
                           Text="{Binding EditUnsavedLabel}" />
                <Border Classes="kbd">
                  <TextBlock Text="{Binding SaveShortcut}"
                             FontFamily="{DynamicResource MmDocumentMonoFontFamily}"
                             FontSize="10"
                             Foreground="{DynamicResource MmTextSoftBrush}" />
                </Border>
              </StackPanel>

              <ToggleButton Name="FindTriggerButton"
                            Classes="mm-icon-button mm-row-button"
                            IsVisible="{Binding ShowsFindToggle}"
                            IsChecked="{Binding IsFindBarOpen, Mode=OneWay}"
                            Command="{Binding ToggleFindBarCommand}"
                            ToolTip.Tip="{Binding FindToggleTooltip}">
                <views:LucideIcon Data="{DynamicResource LucideSearchGeometry}"
                                  Width="14"
                                  Height="14" />
              </ToggleButton>

              <ToggleButton Name="SettingsTriggerButton"
                            Classes="mm-icon-button mm-row-button"
                            IsVisible="{Binding ShowsReadingSettingsToggle}"
                            IsChecked="{Binding IsSettingsOpen, Mode=OneWay}"
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip.Tip="{Binding ReadingSettingsTooltip}">
                <!-- Aa в сетке низкая (~10 из 24 по высоте) и рядом с лупой и
                     карандашом смотрится мельче. Крупнее на 17/14, а обводка
                     1.75 × 14/17, чтобы линия осталась толщиной с соседей. -->
                <views:LucideIcon Data="{DynamicResource LucideALargeSmallGeometry}"
                                  Width="17"
                                  Height="17"
                                  StrokeThickness="1.44" />
              </ToggleButton>

              <Button Name="EditTriggerButton"
                      Classes="mm-icon-button mm-row-button"
                      IsVisible="{Binding ShowsEditToggle}"
                      Command="{Binding ToggleEditModeCommand}"
                      ToolTip.Tip="{Binding EditToggleTooltip}">
                <views:LucideIcon Data="{DynamicResource LucidePenLineGeometry}"
                                  Width="14"
                                  Height="14" />
              </Button>

              <!-- Грязная правка уходит в чтение через диалог несохранённых правок -->
              <Button Name="DoneEditButton"
                      Classes="mm-row-primary"
                      IsVisible="{Binding ShowsDoneButton}"
                      Command="{Binding ToggleEditModeCommand}"
                      ToolTip.Tip="{Binding EditDoneTooltip}">
                <StackPanel Orientation="Horizontal"
                            Spacing="7">
                  <views:LucideIcon Data="{DynamicResource LucideCheckGeometry}"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center" />
                  <TextBlock Text="{Binding EditDoneLabel}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <ToggleButton Name="AppMenuTriggerButton"
                            Classes="mm-icon-button mm-row-button"
                            IsChecked="{Binding IsAppMenuOpen, Mode=OneWay}"
                            Command="{Binding ToggleAppMenuCommand}"
                            ToolTip.Tip="{Binding AppMenuTooltip}">
                <views:LucideIcon Data="{DynamicResource LucideEllipsisGeometry}"
                                  Width="14"
                                  Height="14" />
              </ToggleButton>
            </StackPanel>

            <!-- Кнопки окна Windows: системные глифы 46×44. На macOS окно ведёт
                 светофор, на Linux — рамка оконного менеджера. -->
            <StackPanel Grid.Column="3"
                        Name="WindowButtons"
                        Orientation="Horizontal"
                        IsVisible="{Binding ShowCustomTitleBar}"
                        SizeChanged="OnWindowButtonsSizeChanged">
              <Border Classes="mm-window-buttons-divider" />
              <Button Classes="titlebar"
                      Click="OnMinimizeClick"
                      ToolTip.Tip="{Binding TitleBarMinimize}">
                <Path Data="M0,5 L10,5" />
              </Button>
              <Button Name="TitleBarMaximizeButton"
                      Classes="titlebar"
                      Click="OnMaximizeClick">
                <Grid Width="10" Height="10">
                  <Path Name="TitleBarMaximizeIcon"
                        Data="M0,0 L10,0 L10,10 L0,10 Z"
                        Fill="Transparent" />
                  <Path Name="TitleBarRestoreIcon"
                        IsVisible="False"
                        Data="M3.5,0.5 L9.5,0.5 L9.5,6.5 L7.5,6.5 M0.5,3.5 L6.5,3.5 L6.5,9.5 L0.5,9.5 Z"
                        Fill="Transparent" />
                </Grid>
              </Button>
              <Button Classes="titlebar close"
                      Click="OnCloseClick"
                      ToolTip.Tip="{Binding TitleBarClose}">
                <Path Data="M0,0 L10,10 M10,0 L0,10" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="0"
                Name="WindowRowDivider"
                Classes="mm-window-row-divider" />

        <!-- Файл изменился на диске, а во вкладке есть правки: полоса висит до выбора -->
        <ContentControl Grid.Row="1"
                        Content="{Binding ExternalChangeContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <Border Classes="mm-external-change">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      AutomationProperties.LiveSetting="Polite">
                  <views:LucideIcon Data="{DynamicResource LucideCircleAlertGeometry}"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MmAccentBrush}" />
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ExternalChangeTitle}"
                         FontWeight="SemiBold" />
                    <Run Text="{Binding ExternalChangeMessage}"
                         Foreground="{DynamicResource MmTextSoftBrush}" />
                  </TextBlock>
                  <StackPanel Grid.Column="2"
                              Orientation="Horizontal"
                              Spacing="10"
                              VerticalAlignment="Center">
                    <Button Classes="mm-action-secondary mm-action-raised mm-action-small"
                            Content="{Binding ExternalChangeReload}"
                            ToolTip.Tip="{Binding ExternalChangeReloadTooltip}"
                            Command="{Binding ReloadExternalChangeCommand}" />
                    <Button Classes="mm-action-secondary mm-action-raised mm-action-small"
                            Content="{Binding ExternalChangeKeep}"
                            Command="{Binding KeepExternalChangeCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

      <Panel Grid.Row="2"
             Name="BodyPanel">

        <!-- Стартовый экран строится, только когда окно на нём осталось: запуск с файлом
             его не создаёт вовсе (быстрый путь, ADR-0009 Rule 12) -->
        <ContentControl Content="{Binding WelcomeContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:WelcomeView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
        <views:EmptyDocumentSurfaceView IsVisible="{Binding IsEmptyDocumentSurface}" />
        <ContentControl IsVisible="{Binding IsViewer}"
                        Content="{Binding ActiveDocumentContent}" />
        <views:LoadErrorView IsVisible="{Binding IsError}" />

        <Border Name="ReadingProgressBar"
                Classes="mm-progress"
                IsVisible="{Binding IsViewer}"
                Height="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Background="{DynamicResource MmAccentBrush}"
                IsHitTestVisible="False" />

        <!-- Карточки поиска, Aa и меню ⋯ раскрываются под строкой у правого
             края — одно правило на всю строку (ADR-0009 Rule 2). Отступы держит хост и ставит
             code-behind: сверху он поднят в строку, чтобы карточка встала в 6 под кнопкой,
             а справа на Windows отступает ещё на кнопки окна. -->
        <Panel Name="OverlayCardHost"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,-1,11,0">
          <ContentControl Name="FindBarHost"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          ClipToBounds="False"
                          Content="{Binding FindOverlayContent}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:ShellViewModel">
                <views:FindBarView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <ContentControl Name="AppMenuPanel"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          ClipToBounds="False"
                          Content="{Binding AppMenuOverlayContent}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:ShellViewModel">
                <views:AppMenuPanelView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <ContentControl Name="SettingsPanel"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          ClipToBounds="False"
                          Content="{Binding ReadingSettingsOverlayContent}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:ShellViewModel">
                <views:ReadingSettingsPanelView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Panel>

        <Border Classes="mm-status"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                IsVisible="{Binding ShowsReadingStatus}">
          <TextBlock Text="{Binding ReadingStatusLabel}" />
        </Border>
      </Panel>

      </Grid>

      <!-- Меню сайдбара, контекстное меню строки и список «ещё N» у вкладок — такие же
           карточки, как ⋯ (ADR-0009 Rule 4), но слой их общий и лежит поверх колонок и
           строки окна: карточка шире сайдбара иначе ушла бы под документ вместе с тенью.
           Позицию — от кнопки или от курсора — ставит code-behind. -->
      <Panel Name="SidebarMenuHost"
             Grid.Column="0"
             Grid.ColumnSpan="3"
             ClipToBounds="False">
        <ContentControl Name="FolderMenuPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ClipToBounds="False"
                        Content="{Binding FolderMenuOverlayContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:SidebarFolderMenuView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Name="CreateMenuPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ClipToBounds="False"
                        Content="{Binding CreateMenuOverlayContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:SidebarCreateMenuView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Name="TreeContextMenuPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ClipToBounds="False"
                        Content="{Binding TreeContextMenuOverlayContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:TreeContextMenuView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- «ещё N» прижат вправо: карточка выровнена по правому краю своей кнопки -->
        <ContentControl Name="TabsOverflowMenuPanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ClipToBounds="False"
                        Content="{Binding TabsOverflowMenuOverlayContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:TabsOverflowMenuView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- «+» у вкладок прижат влево: карточка от левого края кнопки, у правого края
             окна сдвигается внутрь -->
        <ContentControl Name="NewTabMenuPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ClipToBounds="False"
                        Content="{Binding NewTabMenuOverlayContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:NewTabMenuView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Panel>

      <!-- Слой перетаскивания — на всё окно, вместе с сайдбаром и строкой: файл можно
           отпустить где угодно. Вторая строка говорит, куда он откроется. -->
      <Panel Grid.Column="0"
             Grid.ColumnSpan="3"
             IsVisible="{Binding IsDragHovering}"
             IsHitTestVisible="False"
             AutomationProperties.LiveSetting="Polite">
        <Border Background="{DynamicResource MmBackgroundBrush}"
                Opacity="0.86" />
        <!-- Пунктирная рамка — не иконка: класс mm-drop-frame guard-тест иконок пропускает -->
        <Rectangle Classes="mm-drop-frame"
                   Margin="10"
                   RadiusX="14"
                   RadiusY="14"
                   Stroke="{DynamicResource MmAccentBrush}"
                   StrokeThickness="2"
                   StrokeDashArray="4,3" />
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24,0">
          <Border Width="60"
                  Height="60"
                  CornerRadius="16"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource MmAccentSoftBrush}">
            <Panel>
              <views:LucideIcon Data="{DynamicResource LucideFileDownGeometry}"
                                Width="28"
                                Height="28"
                                StrokeThickness="1.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MmAccentBrush}"
                                IsVisible="{Binding !IsDropTargetFolder}" />
              <views:LucideIcon Data="{DynamicResource LucideFolderDownGeometry}"
                                Width="28"
                                Height="28"
                                StrokeThickness="1.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MmAccentBrush}"
                                IsVisible="{Binding IsDropTargetFolder}" />
            </Panel>
          </Border>
          <TextBlock Text="{Binding DragDropHint}"
                     Margin="0,18,0,0"
                     FontFamily="{DynamicResource MmDocumentSansFontFamily}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource MmTextBrush}" />
          <TextBlock Text="{Binding DropTargetDetails}"
                     IsVisible="{Binding HasDropTargetDetails}"
                     Margin="0,6,0,0"
                     FontFamily="{DynamicResource MmDocumentSansFontFamily}"
                     FontSize="13.5"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource MmTextSoftBrush}" />
        </StackPanel>
      </Panel>

      <!-- Модальные диалоги (ADR-0009 Rule 10): один скрим на всё окно — сайдбар,
           вкладки и строку. Карточки создаются в момент вопроса, а не на старте. -->
      <!-- Окно «Настройки» лежит под вопросами: диалог о правках, поднятый при закрытии
           окна, встаёт поверх него. -->
      <ContentControl Name="AppSettingsDialogHost"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Content="{Binding AppSettingsContent}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:ShellViewModel">
            <views:AppSettingsDialogView />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <ContentControl Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Content="{Binding DeletePromptContent}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:ShellViewModel">
            <views:ModalDialogFrame FocusResetKey="{Binding DeletePromptMessage}">
              <StackPanel>
                <TextBlock Classes="mm-dialog-title"
                           Text="{Binding DeletePromptTitle}" />
                <TextBlock Classes="mm-dialog-body"
                           Text="{Binding DeletePromptMessage}" />
                <Grid Classes="mm-dialog-buttons"
                      ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                  <!-- Фокус сразу на «Отмене»: удаление по случайному Enter не случится -->
                  <Button Classes="mm-action-secondary"
                          Grid.Column="{Binding DeleteCancelColumn}"
                          KeyboardNavigation.TabIndex="{Binding DeleteCancelColumn}"
                          views:ModalDialogFrame.IsInitialFocus="True"
                          Content="{Binding DeleteCancelLabel}"
                          Command="{Binding CancelDeleteCommand}"
                          ToolTip.Tip="{Binding DialogCancelShortcut}" />
                  <Button Classes="mm-action-destructive"
                          Grid.Column="{Binding DeleteConfirmColumn}"
                          KeyboardNavigation.TabIndex="{Binding DeleteConfirmColumn}"
                          IsVisible="{Binding !IsDeleteErrorPrompt}"
                          Content="{Binding DeleteConfirmLabel}"
                          Command="{Binding ConfirmDeleteCommand}" />
                </Grid>
              </StackPanel>
            </views:ModalDialogFrame>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- Пропавшая запись «Недавних»: убрать её из списка — не потеря данных,
           поэтому Enter сразу попадает в «Убрать» -->
      <ContentControl Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Content="{Binding RecentRemovePromptContent}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:ShellViewModel">
            <views:ModalDialogFrame>
              <StackPanel>
                <TextBlock Classes="mm-dialog-title"
                           Text="{Binding RecentRemovePromptTitle}" />
                <TextBlock Classes="mm-dialog-body"
                           Text="{Binding RecentRemovePromptMessage}" />
                <Grid Classes="mm-dialog-buttons"
                      ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                  <Button Classes="mm-action-secondary"
                          Grid.Column="{Binding RecentRemoveCancelColumn}"
                          KeyboardNavigation.TabIndex="{Binding RecentRemoveCancelColumn}"
                          Content="{Binding RecentRemoveCancel}"
                          Command="{Binding CancelRecentRemoveCommand}"
                          ToolTip.Tip="{Binding DialogCancelShortcut}" />
                  <Button Classes="mm-action-primary"
                          Grid.Column="{Binding RecentRemoveConfirmColumn}"
                          KeyboardNavigation.TabIndex="{Binding RecentRemoveConfirmColumn}"
                          IsDefault="True"
                          views:ModalDialogFrame.IsInitialFocus="True"
                          Content="{Binding RecentRemoveConfirm}"
                          Command="{Binding ConfirmRecentRemoveCommand}"
                          ToolTip.Tip="{Binding DialogConfirmShortcut}" />
                </Grid>
              </StackPanel>
            </views:ModalDialogFrame>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <ContentControl Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Content="{Binding DirtyPromptContent}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:ShellViewModel">
            <views:ModalDialogFrame>
              <!-- «Не сохранять» — ⌘⌫ на macOS, Ctrl+Backspace на Windows и Linux. Пара
                   сочетаний, как у окна; действует, только пока фокус в диалоге. -->
              <views:ModalDialogFrame.KeyBindings>
                <KeyBinding Gesture="Ctrl+Back" Command="{Binding ConfirmDirtyDiscardCommand}" />
                <KeyBinding Gesture="Cmd+Back" Command="{Binding ConfirmDirtyDiscardCommand}" />
              </views:ModalDialogFrame.KeyBindings>
              <StackPanel>
                <TextBlock Classes="mm-dialog-title"
                           Text="{Binding DirtyPromptTitle}" />
                <TextBlock Classes="mm-dialog-body"
                           Text="{Binding DirtyPromptMessage}" />
                <!-- Ошибка сохранения — внутри карточки: диалог остаётся открытым -->
                <Border Classes="mm-dialog-error-shell"
                        IsVisible="{Binding HasDirtyPromptError}">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">
                    <views:LucideIcon Classes="mm-dialog-error-icon"
                                      Data="{DynamicResource LucideCircleAlertGeometry}"
                                      Width="16"
                                      Height="16" />
                    <TextBlock Grid.Column="1"
                               Classes="mm-dialog-error"
                               Text="{Binding DirtyPromptErrorMessage}" />
                  </Grid>
                </Border>
                <Grid Classes="mm-dialog-buttons"
                      ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                  <Button Classes="mm-action-secondary"
                          Grid.Column="{Binding DirtyPromptDiscardColumn}"
                          KeyboardNavigation.TabIndex="{Binding DirtyPromptDiscardColumn}"
                          Content="{Binding DirtyPromptDiscard}"
                          Command="{Binding ConfirmDirtyDiscardCommand}"
                          ToolTip.Tip="{Binding DirtyPromptDiscardShortcut}" />
                  <Button Classes="mm-action-secondary"
                          Grid.Column="{Binding DirtyPromptCancelColumn}"
                          KeyboardNavigation.TabIndex="{Binding DirtyPromptCancelColumn}"
                          Content="{Binding DirtyPromptCancel}"
                          Command="{Binding CancelDirtyPromptCommand}"
                          ToolTip.Tip="{Binding DialogCancelShortcut}" />
                  <!-- Enter — «Сохранить»; Esc отменяет через общий Escape окна -->
                  <Button Classes="mm-action-primary"
                          Grid.Column="{Binding DirtyPromptSaveColumn}"
                          KeyboardNavigation.TabIndex="{Binding DirtyPromptSaveColumn}"
                          IsDefault="True"
                          views:ModalDialogFrame.IsInitialFocus="True"
                          Content="{Binding DirtyPromptSave}"
                          Command="{Binding ConfirmDirtySaveCommand}"
                          ToolTip.Tip="{Binding DialogConfirmShortcut}" />
                </Grid>
              </StackPanel>
            </views:ModalDialogFrame>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

    </Grid>
  </Border>

</Window>
